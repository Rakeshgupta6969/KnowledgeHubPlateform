        "tags": ["Public Help Center"],
        "parameters": [
          { "name": "tenantSlug", "in": "path", "required": true, "schema": { "type": "string", "example": "acme" } }
        ],
        "responses": {
          "200": {
            "description": "Public tenant configuration",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tenant": { "$ref": "#/components/schemas/Tenant" }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/404NotFoundError" }
        }
      }
    },
    "/public/{tenantSlug}/categories": {
      "get": {
        "summary": "Public Categories",
        "description": "Returns active categories with count of published articles. Cached in Redis for 15 minutes.",
        "tags": ["Public Help Center"],
        "parameters": [
          { "name": "tenantSlug", "in": "path", "required": true, "schema": { "type": "string", "example": "acme" } }
        ],
        "responses": {
          "200": {
            "description": "Public categories list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tenant": { "$ref": "#/components/schemas/Tenant" },
                    "categories": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/404NotFoundError" }
        }
      }
    },
    "/public/{tenantSlug}/articles": {
      "get": {
        "summary": "Public Published Articles",
        "description": "Returns paginated list of published articles only. Supports category filter.",
        "tags": ["Public Help Center"],
        "parameters": [
          { "name": "tenantSlug", "in": "path", "required": true, "schema": { "type": "string", "example": "acme" } },
          { "name": "categorySlug", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated published articles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tenant": { "$ref": "#/components/schemas/Tenant" },
                    "category": { "type": "object", "nullable": true },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Article" } },
                    "meta": { "$ref": "#/components/schemas/PaginationMeta" }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/404NotFoundError" }
        }
      }
    },
    "/public/{tenantSlug}/articles/{slug}": {
      "get": {
        "summary": "Public Article Detail",
        "description": "Returns full published article. CRITICAL: DRAFT or ARCHIVED articles return 404 to public visitors. Cached in Redis for 15 minutes.",
        "tags": ["Public Help Center"],
        "parameters": [
          { "name": "tenantSlug", "in": "path", "required": true, "schema": { "type": "string", "example": "acme" } },
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string", "example": "how-to-update-credit-card" } }
        ],
        "responses": {
          "200": {
            "description": "Published article detail",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tenant": { "$ref": "#/components/schemas/Tenant" },
                    "article": { "$ref": "#/components/schemas/Article" }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/404NotFoundError" }
        }
      }
    },
    "/public/{tenantSlug}/search": {
      "get": {
        "summary": "PostgreSQL Full-Text Search",
        "description": "Full-text search on published article title and content with relevance ranking. Rate-limited to 30 queries/min.",
        "tags": ["Public Help Center"],
        "parameters": [
          { "name": "tenantSlug", "in": "path", "required": true, "schema": { "type": "string", "example": "acme" } },
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 100 } },
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Ranked search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tenant": { "$ref": "#/components/schemas/Tenant" },
                    "query": { "type": "string" },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Article" } },
                    "meta": { "$ref": "#/components/schemas/PaginationMeta" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/400ValidationError" },
          "429": { "$ref": "#/components/responses/429RateLimitError" }
        }
      }
    },
    "/public/{tenantSlug}/articles/{slug}/feedback": {
      "post": {
        "summary": "Submit Article Feedback",
        "description": "Records helpful/unhelpful rating with optional comment. Abuse controlled with IP hashing and rate-limited to 15 submissions per 15 min.",
        "tags": ["Public Help Center"],
        "parameters": [
          { "name": "tenantSlug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "helpful": { "type": "boolean", "example": true },
                  "comment": { "type": "string", "maxLength": 1000, "nullable": true, "example": "Clear instructions, thanks!" }
                },
                "required": ["helpful"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Feedback recorded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Thank you for your feedback!" },
                    "feedback": { "type": "object" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/400ValidationError" },
          "404": { "$ref": "#/components/responses/404NotFoundError" },
          "429": { "$ref": "#/components/responses/429RateLimitError" }
        }
      }
    },
    "/public/{tenantSlug}/articles/{slug}/view": {
      "post": {
        "summary": "Record Article View Event",
        "description": "Records view event with bot filtering and daily session deduplication.",
        "tags": ["Public Help Center"],
        "parameters": [
          { "name": "tenantSlug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "View event recorded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "recorded": { "type": "boolean", "example": true }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/404NotFoundError" }
        }
      }
    },
    "/analytics/overview": {
      "get": {
        "summary": "Workspace Analytics Overview",
        "description": "Returns aggregated views, feedback ratio, and total searches for active workspace. Requires OWNER or ADMIN role.",
        "tags": ["Analytics"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "from", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "to", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "days", "in": "query", "schema": { "type": "integer", "enum": [7, 30, 90, 365], "default": 30 } }
        ],
        "responses": {
          "200": {
            "description": "Aggregated analytics metrics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "period": { "type": "object" },
                    "metrics": { "type": "object" }
                  }
                }
              }
            }
          },
          "403": { "$ref": "#/components/responses/403ForbiddenError" }
        }
      }
    },
    "/analytics/articles": {
      "get": {
        "summary": "Top Performing Articles",
        "description": "Returns top viewed articles with helpfulness statistics. Requires OWNER or ADMIN role.",
        "tags": ["Analytics"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "from", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "to", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": {
            "description": "Ranked articles list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "period": { "type": "object" },
                    "data": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          },
          "403": { "$ref": "#/components/responses/403ForbiddenError" }
        }
      }
    },
    "/analytics/searches": {
      "get": {
        "summary": "Search Analytics & Content Gaps",
        "description": "Returns popular search terms and queries with 0 results. Requires OWNER or ADMIN role.",
        "tags": ["Analytics"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "from", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "to", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": {
            "description": "Search analytics queries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "period": { "type": "object" },
                    "popularSearches": { "type": "array", "items": { "type": "object" } },
                    "noResultSearches": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          },
          "403": { "$ref": "#/components/responses/403ForbiddenError" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "400ValidationError": {
        "description": "Validation error or invalid request parameters",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/StandardError" }
          }
        }
      },
      "401UnauthorizedError": {
        "description": "Missing, invalid, or expired authentication token",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/StandardError" }
          }
        }
      },
      "403ForbiddenError": {
        "description": "Insufficient permissions or unauthorized cross-tenant attempt",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/StandardError" }
          }
        }
      },
      "404NotFoundError": {
        "description": "Resource not found or private cross-tenant non-disclosing 404",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/StandardError" }
          }
        }
      },
      "409ConflictError": {
        "description": "Duplicate unique constraint violation (slug or email collision)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/StandardError" }
          }
        }
      },
      "429RateLimitError": {
        "description": "Rate limit exceeded",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/StandardError" }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refreshToken"
      }
    },
    "schemas": {
      "StandardError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": { "type": "array", "items": { "type": "object" } }
            },
            "required": ["code", "message"]
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "total": { "type": "integer" },
          "page": { "type": "integer" },
          "limit": { "type": "integer" },
          "totalPages": { "type": "integer" }
        },
        "required": ["total", "page", "limit", "totalPages"]
      },
      "Tenant": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "logoUrl": { "type": "string", "nullable": true },
          "primaryColor": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "sortOrder": { "type": "integer" },
          "status": { "type": "string", "enum": ["ACTIVE", "ARCHIVED"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Article": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "excerpt": { "type": "string", "nullable": true },
          "content": { "type": "string" },
          "status": { "type": "string", "enum": ["DRAFT", "PUBLISHED", "ARCHIVED"] },
          "publishedAt": { "type": "string", "format": "date-time", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "category": { "$ref": "#/components/schemas/Category" },
          "author": { "$ref": "#/components/schemas/User" }
        }
      },
      "AuditLog": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "action": { "type": "string" },
          "resourceType": { "type": "string" },
          "resourceId": { "type": "string", "format": "uuid" },
          "details": { "type": "object", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "actor": { "$ref": "#/components/schemas/User" }
        }
      }
    }
  }
}